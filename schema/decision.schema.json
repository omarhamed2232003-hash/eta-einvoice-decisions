{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omarhamed2232003-hash/eta-einvoice-decisions/schema/decision.schema.json",
  "title": "ETA e-invoice / e-receipt decisions dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "sources", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title_ar", "title_en", "jurisdiction", "authority", "compiled_on", "disclaimer_ar", "disclaimer_en"],
      "properties": {
        "id": { "type": "string" },
        "title_ar": { "type": "string" },
        "title_en": { "type": "string" },
        "jurisdiction": { "type": "string", "minLength": 2 },
        "authority": { "type": "string" },
        "compiled_on": { "$ref": "#/$defs/isoDate" },
        "coverage": { "type": "string" },
        "disclaimer_ar": { "type": "string" },
        "disclaimer_en": { "type": "string" },
        "license": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "publisher", "title_ar", "url", "retrieved_on"],
      "properties": {
        "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "type": { "enum": ["official_web_page", "official_pdf", "official_news"] },
        "publisher": { "type": "string" },
        "title_ar": { "type": "string", "minLength": 3 },
        "title_en": { "type": ["string", "null"] },
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9-]+\\.)*eta\\.gov\\.eg/",
          "description": "Official sources must live on eta.gov.eg."
        },
        "retrieved_on": { "$ref": "#/$defs/isoDate" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "sub"],
      "properties": {
        "main": { "type": ["integer", "null"], "minimum": 1 },
        "sub": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "scope_ar"],
      "properties": {
        "from": { "$ref": "#/$defs/isoDate" },
        "scope_ar": { "type": "string", "minLength": 3 },
        "scope_en": { "type": ["string", "null"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "system", "number", "year", "issuer", "title_ar", "title_en",
        "issued_on", "effective_from", "phase", "source_ids", "primary_source_id", "verification"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^eta-(einv|erec)-\\d{4}-\\d{4}$" },
        "system": { "enum": ["einvoice", "ereceipt"] },
        "number": { "type": "string", "pattern": "^\\d{1,4}$" },
        "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "issuer": { "enum": ["head_of_eta", "minister_of_finance"] },
        "title_ar": { "type": "string", "minLength": 5 },
        "title_en": { "type": ["string", "null"] },
        "scope_ar": { "type": ["string", "null"] },
        "scope_en": { "type": ["string", "null"] },
        "issued_on": { "oneOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] },
        "effective_from": { "oneOf": [{ "$ref": "#/$defs/isoDate" }, { "type": "null" }] },
        "effective_schedule": { "type": "array", "items": { "$ref": "#/$defs/scheduleEntry" } },
        "phase": { "$ref": "#/$defs/phase" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "primary_source_id": { "type": "string" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "checked_on", "notes"],
          "properties": {
            "level": { "enum": ["document_read", "official_summary", "listing_only", "referenced"] },
            "checked_on": { "$ref": "#/$defs/isoDate" },
            "notes": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
